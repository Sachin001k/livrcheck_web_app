# Copy to .env.local and fill in — the same values as the Flutter app's env.json.
# Only the anon (publishable) key goes here; it ships in public JS and RLS protects
# the data. NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here
